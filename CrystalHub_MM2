local Library = {}
Library.Theme   = Theme
Library.Windows = {}
Library.Entries = {}
Library.FloatersLocked = false  -- when true, on-screen buttons can't be dragged

-- Library.Flags.имя_флага -> текущее значение элемента
-- Library.Flags.имя_флага = значение -> задать элементу значение
Library.Flags = setmetatable({}, {
	__index = function(_, key)
		local entry = Library.Entries[key]
		if entry and entry.Get then
			return entry.Get()
		end
		return nil
	end,
	__newindex = function(_, key, value)
		local entry = Library.Entries[key]
		if entry and entry.Set then
			entry.Set(value)
		end
	end,
})

