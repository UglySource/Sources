		espSec:AddToggle("Chams (through walls)", true, function(v) if ESP then ESP.Settings.Chams = v end end, "cmb_esp_chams")
		espSec:AddToggle("Color by role", true, function(v) if ESP then ESP.Settings.Roles = v end end, "cmb_esp_roles")
