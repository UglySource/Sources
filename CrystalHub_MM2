		--==================== TROLL (non-sexual) ====================--
		local trollTab = Window:AddTab("Troll")
		local trollSec = trollTab:AddSection("Troll")
		local trollTarget
		local trollNames0 = playerNames()
		trollTarget = trollNames0[1]
		local trollDrop = trollSec:AddDropdown("Player", trollNames0, trollTarget, function(v) trollTarget = v end, "troll_target")
