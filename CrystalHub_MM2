-- свои, с префиксом v-, чтобы не зависеть от внутренностей библиотеки
local function vnew(className, props)
	local inst   = Instance.new(className)
	local parent = props.Parent
	props.Parent = nil
	for key, value in pairs(props) do
		inst[key] = value
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function vcorner(inst, radius)
	return vnew("UICorner", { CornerRadius = UDim.new(0, radius), Parent = inst })
end

local function vstroke(inst, color, thickness, transparency)
	return vnew("UIStroke", {
		Color        = color,
		Thickness    = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent       = inst,
	})
end

local function vtween(inst, props, time, style, direction)
	local info = TweenInfo.new(time or 0.25,
		style or Enum.EasingStyle.Quint,
		direction or Enum.EasingDirection.Out)
	local anim = TweenService:Create(inst, info, props)
	anim:Play()
	return anim
end

local function viewport()
	local camera = workspace.CurrentCamera
	if camera and camera.ViewportSize.Y > 0 then
