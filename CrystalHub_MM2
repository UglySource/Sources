local function detectPhone()
	if not UserInputService.TouchEnabled then
		return false
	end
	if UserInputService.KeyboardEnabled then
		return false
	end
	return true
end

local IS_PHONE = detectPhone()
local function smallScreen()
	local size = viewport()
	return IS_PHONE or size.X < 900 or size.Y < 560
end

-- на телефоне режем количество деталей: неон дорогой, а экран мелкий
local QUALITY = IS_PHONE and 0.6 or 1
local function quantity(count, minimum)
	return math.max(minimum or 1, math.floor(count * QUALITY + 0.5))
end

-- ищем самый большой Frame окна и поджимаем его под экран телефона
local adaptedWindows = setmetatable({}, { __mode = "k" })
local function adaptWindow(Window)
	if not Window or not Window.Gui or adaptedWindows[Window] then
		return false
	end
	adaptedWindows[Window] = true
	if not smallScreen() then
		return false
	end
	local ok = pcall(function()
		local main, area = nil, 0
		for _, child in ipairs(Window.Gui:GetChildren()) do
			if child:IsA("Frame") then
				local size = child.AbsoluteSize
				if size.X * size.Y > area then
					main, area = child, size.X * size.Y
				end
			end
		end
		if not main then
			return
		end
		local screen = viewport()
		local wanted = math.min(screen.X / (main.AbsoluteSize.X + 40),
			screen.Y / (main.AbsoluteSize.Y + 60))
		local scale = main:FindFirstChildOfClass("UIScale") or vnew("UIScale", { Parent = main })
		scale.Scale = math.clamp(wanted, 0.55, 1)
		-- окно по центру: на телефоне попасть в угол пальцем тяжело
		main.AnchorPoint = Vector2.new(0.5, 0.5)
		main.Position    = UDim2.fromScale(0.5, 0.5)
	end)
	return ok
end

if Library then
