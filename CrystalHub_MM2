local noclipParts, noclipChar, noclipAddConn = {}, nil, nil
local function refreshNoclipCache()
	noclipParts, noclipChar = {}, char()
	if not noclipChar then return end
	for _, p in ipairs(noclipChar:GetDescendants()) do
		if p:IsA("BasePart") then noclipParts[#noclipParts + 1] = p end
	end
	if noclipAddConn then noclipAddConn:Disconnect() end
	noclipAddConn = noclipChar.DescendantAdded:Connect(function(p)
		if p:IsA("BasePart") then noclipParts[#noclipParts + 1] = p end
	end)
end
RunService.Stepped:Connect(function()
	if not st.Noclip then return end
	local c = char()
	if not c then return end
	if c ~= noclipChar then refreshNoclipCache() end
	for _, p in ipairs(noclipParts) do
		if p.Parent and p.CanCollide then p.CanCollide = false end
	end
end)
