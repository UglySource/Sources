--        COMBAT (Aim / AimLock / Silent / Shoot / Fling) + ESP        --
--======================================================================--
-- Собрано из лучших кусков трёх сурсов:
--  · роль игрока берём из remote GetPlayerData (Скрипт3) — точнее, чем по
--    инструменту; фолбэк — по ножу/гану (скрипт.txt).
--  · выстрел по мардеру: Gun.KnifeLocal.CreateBeam.RemoteFunction (Скрипт3).
--  · AimLock (камера намертво на мардера) — наш код.
--  · Fling — SHubFling (Скрипт3), самый надёжный.
-- Весь модуль в IIFE (лимит локалов главного чанка).
;(function()
local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS        = game:GetService("UserInputService")
local RS         = game:GetService("ReplicatedStorage")
local Workspace  = workspace
local LP         = Players.LocalPlayer

local Aim, ESP, Combat = {}, {}, {}

local function cam() return Workspace.CurrentCamera end
local function myChar() return LP.Character end
local function myRoot()
	local c = LP.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

-------------------------------------------------- роли (GetPlayerData + фолбэк)
local dataRemote
local function getDataRemote()
	if dataRemote and dataRemote.Parent then return dataRemote end
	dataRemote = RS:FindFirstChild("GetPlayerData", true)
	return dataRemote
end
local function fetchRoles()
	local rem = getDataRemote()
	if not rem then return nil end
	local ok, data = pcall(function() return rem:InvokeServer() end)
	if ok and type(data) == "table" then return data end
	return nil
end
-- кэш ролей, чтобы не дёргать remote каждый кадр
local roleCache, roleAt = {}, 0
local function roles()
	local now = os.clock()
	if now - roleAt > 0.3 then
		roleAt = now
		local data = fetchRoles()
		if data then
			local m = {}
			for name, d in pairs(data) do m[name] = d and d.Role end
			roleCache = m
		end
	end
	return roleCache
end
local function hasTool(pl, ...)
	local names = { ... }
	local function scan(c)
		if not c then return false end
		for _, n in ipairs(names) do if c:FindFirstChild(n) then return true end end
		return false
	end
	return scan(pl.Character) or scan(pl:FindFirstChildOfClass("Backpack"))
end
local function findMurderer()
	for name, role in pairs(roles()) do
		if role == "Murderer" then
			local pl = Players:FindFirstChild(name)
			if pl and pl ~= LP then return pl end
		end
	end
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= LP and hasTool(pl, "Knife") then return pl end
	end
	return nil
end
local function findSheriff()
	-- в MM2 пистолет у ШЕРИФА, поэтому для стила гана цель — шериф (держатель пушки)
	for name, role in pairs(roles()) do
		if role == "Sheriff" then
			local pl = Players:FindFirstChild(name)
			if pl and pl ~= LP then return pl end
		end
	end
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= LP and hasTool(pl, "Gun", "Revolver") then return pl end
	end
	return nil
end
local function alive(pl)
	local ch = pl and pl.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if ch and hum and hum.Health > 0 then return true, ch, hum end
	return false
end
local function partOf(ch, name)
	return ch:FindFirstChild(name) or ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Head")
end
local function w2s(pos)
	local v, on = cam():WorldToViewportPoint(pos)
	return Vector2.new(v.X, v.Y), on
end
local function colorFor(pl)
	local role = roles()[pl.Name]
	if role == "Murderer" then return ESP.Settings.MurderColor end
	if role == "Sheriff" then return ESP.Settings.SheriffColor end
	if role == "Hero" then return ESP.Settings.HeroColor end
	if not role then
		if pl ~= LP and hasTool(pl, "Knife") then return ESP.Settings.MurderColor end
		if hasTool(pl, "Gun", "Revolver") then return ESP.Settings.SheriffColor end
	end
	return ESP.Settings.Color
end

--==================================================================-- ESP
ESP.Settings = {
	Enabled = false, Box = true, Names = true, Distance = true,
	Tracer = false, Chams = true, Roles = true,
	Color        = Color3.fromRGB(0, 255, 140),
	MurderColor  = Color3.fromRGB(255, 45, 45),
	SheriffColor = Color3.fromRGB(55, 120, 255),
	HeroColor    = Color3.fromRGB(255, 220, 40),
}
local esp = ESP.Settings
local espGui, espConn, items = nil, nil, {}

local function newLbl(parent, bold, sz, anchorY)
	return vnew("TextLabel", {
		BackgroundTransparency = 1, Font = bold and UITheme.FontBold or UITheme.Font,
		TextSize = sz, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.35,
		AnchorPoint = Vector2.new(0.5, anchorY), Visible = false, Parent = parent,
	})
end
local function makeItem()
	local holder = vnew("Frame", { BackgroundTransparency = 1, Parent = espGui })
	local box = vnew("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5), Visible = false, Parent = holder,
	})
	vstroke(box, Color3.new(1, 1, 1), 1.5, 0)
	local tracer = vnew("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5), Visible = false, Parent = holder,
	})
	return {
		holder = holder, box = box, tracer = tracer,
		name = newLbl(holder, true, 13, 1), dist = newLbl(holder, false, 12, 0), hl = nil,
	}
end
local function killItem(it)
	if not it then return end
	if it.hl then it.hl:Destroy() end
	if it.holder then it.holder:Destroy() end
end
local function updateESP()
	if not (esp.Enabled and espGui) then return end
	local root = myRoot()
	local vp = cam().ViewportSize
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= LP then
			local ok, ch = alive(pl)
			local it = items[pl]
			if ok then
				if not it then it = makeItem() items[pl] = it end
				local hrp = ch:FindFirstChild("HumanoidRootPart")
				local head = ch:FindFirstChild("Head") or hrp
				local col = esp.Roles and colorFor(pl) or esp.Color
				if esp.Chams then
					if not it.hl or it.hl.Parent ~= ch then
						if it.hl then it.hl:Destroy() end
						it.hl = Instance.new("Highlight")
						it.hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						it.hl.FillTransparency = 0.55
						it.hl.Parent = ch
					end
					it.hl.FillColor = col
					it.hl.OutlineColor = col
				elseif it.hl then it.hl:Destroy() it.hl = nil end
				local shown = false
				if hrp and head then
					local tS, onT = w2s(head.Position + Vector3.new(0, 0.6, 0))
					local bS, onB = w2s(hrp.Position - Vector3.new(0, 3, 0))
					if onT or onB then
						shown = true
						local h = math.abs(bS.Y - tS.Y)
						local w = h * 0.62
						local cx, cy = (tS.X + bS.X) / 2, (tS.Y + bS.Y) / 2
						it.box.Visible = esp.Box
						if esp.Box then
							it.box.Size = UDim2.fromOffset(w, h)
							it.box.Position = UDim2.fromOffset(cx, cy)
							it.box:FindFirstChildOfClass("UIStroke").Color = col
						end
						it.name.Visible = esp.Names
						if esp.Names then
							it.name.Text = pl.DisplayName or pl.Name
							it.name.TextColor3 = col
							it.name.Position = UDim2.fromOffset(cx, cy - h / 2 - 2)
							it.name.Size = UDim2.fromOffset(170, 16)
						end
						it.dist.Visible = esp.Distance and root ~= nil
						if it.dist.Visible then
							it.dist.Text = math.floor((root.Position - hrp.Position).Magnitude) .. "m"
							it.dist.TextColor3 = col
							it.dist.Position = UDim2.fromOffset(cx, cy + h / 2 + 2)
							it.dist.Size = UDim2.fromOffset(120, 14)
						end
						it.tracer.Visible = esp.Tracer
						if esp.Tracer then
							it.tracer.BackgroundColor3 = col
							local x1, y1, x2, y2 = vp.X / 2, vp.Y, cx, cy + h / 2
							local dx, dy = x2 - x1, y2 - y1
							local len = math.sqrt(dx * dx + dy * dy)
							it.tracer.Size = UDim2.fromOffset(len, 1.5)
							it.tracer.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
							it.tracer.Rotation = math.deg(math.atan2(dy, dx))
						end
					end
				end
				if not shown then
					it.box.Visible = false it.name.Visible = false
					it.dist.Visible = false it.tracer.Visible = false
				end
			elseif it then
				killItem(it) items[pl] = nil
			end
		end
	end
end
function ESP.SetEnabled(state)
	esp.Enabled = state and true or false
	if esp.Enabled then
		if not espGui then
			espGui = vnew("ScreenGui", {
				Name = "CrystalHub_ESP", ResetOnSpawn = false, IgnoreGuiInset = true,
				DisplayOrder = 4000, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = PlayerGui,
			})
		end
		if not espConn then espConn = RunService.RenderStepped:Connect(updateESP) end
	else
		if espConn then espConn:Disconnect() espConn = nil end
		for pl, it in pairs(items) do killItem(it) items[pl] = nil end
		if espGui then espGui:Destroy() espGui = nil end
	end
end
Players.PlayerRemoving:Connect(function(pl)
	if items[pl] then killItem(items[pl]) items[pl] = nil end
end)

--==================================================================-- AIM
Aim.Settings = {
	Enabled        = false,
	Silent         = true,     -- перехват выстрела гана -> в мардера
	AimLock        = false,    -- камера намертво на цель
	TargetMurderer = true,     -- цель — мардер (иначе ближайший к курсору)
	TargetPart     = "Head",
	Key            = Enum.KeyCode.E,
	HoldKey        = true,     -- AimLock только пока держишь клавишу
	Smooth         = 0,        -- 0 = намертво
	FOV            = 250,
	Prediction     = 0.15,
}
local aim = Aim.Settings
local aimConn, held, downC, upC, watchC, gunC = nil, false, nil, nil, nil, nil

local function currentTarget()
	if aim.TargetMurderer then
		local m = findMurderer()
		if m then local ok, ch = alive(m); if ok then return partOf(ch, aim.TargetPart), m end end
	end
	local mouse = UIS:GetMouseLocation()
	local best, bd
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= LP then
			local ok, ch = alive(pl)
			if ok then
				local part = partOf(ch, aim.TargetPart)
				local sp, on = w2s(part.Position)
				local d = (sp - mouse).Magnitude
				if on and d <= aim.FOV and (not bd or d < bd) then best, bd = part, d end
			end
		end
	end
	return best
end
local function predicted(part)
	local vel = part.AssemblyLinearVelocity or Vector3.zero
	return part.Position + vel * aim.Prediction
end
local function aimStep()
	if not (aim.Enabled and aim.AimLock) then return end
	if aim.HoldKey and not held then return end
	local target = currentTarget()
	if not target then return end
	local c = cam()
	local goal = CFrame.new(c.CFrame.Position, predicted(target))
	if aim.Smooth and aim.Smooth > 0 then
		c.CFrame = c.CFrame:Lerp(goal, math.clamp(1 - aim.Smooth, 0.08, 1))
	else
		c.CFrame = goal
	end
end

-- Shoot the murderer through the gun remote (Script3): Gun.KnifeLocal.CreateBeam.RemoteFunction
-- Find our gun: equipped in the character first, otherwise in the backpack.
local GUN_NAMES = { "Gun", "Revolver", "Pistol" }
local function looksLikeGun(inst)
	if not (inst and inst:IsA("Tool")) then return false end
	for _, n in ipairs(GUN_NAMES) do
		if inst.Name == n then return true end
	end
	-- fallback: any tool that carries the MM2 shooting script/remote
	return inst:FindFirstChild("KnifeLocal") ~= nil
end
local function findMyGun()
	local ch = myChar()
	if ch then
		for _, t in ipairs(ch:GetChildren()) do
			if looksLikeGun(t) then return t, true end -- true = already in hand
		end
	end
	local bp = LP:FindFirstChildOfClass("Backpack")
	if bp then
		for _, t in ipairs(bp:GetChildren()) do
			if looksLikeGun(t) then return t, false end -- false = still in backpack
		end
	end
	return nil
end
-- if the gun is in the backpack, equip it, otherwise KnifeLocal.CreateBeam won't fire
local function equipGun()
	local ch = myChar()
	local gun, equipped = findMyGun()
	if not gun then return nil end
	if not equipped then
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if hum then
			pcall(function() hum:EquipTool(gun) end)
			task.wait(0.05)
			gun = (myChar() and findMyGun()) or gun
		end
	end
	return gun
end
-- locate the shoot remote inside the gun tool (robust to small structure changes)
local function findGunRemote(gun)
	local kl = gun:FindFirstChild("KnifeLocal")
	local cb = kl and kl:FindFirstChild("CreateBeam")
	if cb then
		local r = cb:FindFirstChild("RemoteFunction")
			or cb:FindFirstChildWhichIsA("RemoteFunction")
			or cb:FindFirstChildWhichIsA("RemoteEvent")
		if r then return r end
	end
	-- fallback 1: a CreateBeam nested anywhere inside the tool
	local cb2 = gun:FindFirstChild("CreateBeam", true)
	if cb2 then
		local r = cb2:FindFirstChildWhichIsA("RemoteFunction")
			or cb2:FindFirstChildWhichIsA("RemoteEvent")
		if r then return r end
	end
	-- fallback 2: any remote inside the tool
	return gun:FindFirstChildWhichIsA("RemoteFunction", true)
		or gun:FindFirstChildWhichIsA("RemoteEvent", true)
end
local function gunRemote()
	local gun = equipGun()
	if not gun then return nil, "nogun" end
	local rf = findGunRemote(gun)
	if not rf then return nil, "noremote" end
	return rf
end
function Combat.ShootMurderer()
	-- no murderer: don't stay silent, say why
	local m = findMurderer()
	if not m then
		Library:Notify({ Title = "Shoot", Text = "Murderer not found", Kind = "warning" })
		return false
	end
	local ok, ch = alive(m)
	if not ok then
		Library:Notify({ Title = "Shoot", Text = "Murderer is dead / has no character", Kind = "warning" })
		return false
	end
	local rem, why = gunRemote()
	if not rem then
		if why == "noremote" then
			-- gun IS in hand, but its shoot remote couldn't be located
			Library:Notify({ Title = "Shoot", Text = "Gun found, but its shoot remote is missing", Kind = "error" })
		else
			-- you simply have no gun (not sheriff/hero)
			Library:Notify({ Title = "Shoot", Text = "No gun in hand (you're not sheriff/hero)", Kind = "error" })
		end
		return false
	end
	local pos = predicted(partOf(ch, aim.TargetPart))
	local fired, err = pcall(function()
		if rem:IsA("RemoteFunction") then
			rem:InvokeServer(1, pos, "AH2")
		elseif rem:IsA("RemoteEvent") then
			rem:FireServer(1, pos, "AH2")
		end
	end)
	if not fired then
		Library:Notify({ Title = "Shoot", Text = "Shot error: " .. tostring(err), Kind = "error" })
	end
	return fired
end
-- silent: every shot you fire from the gun goes at the murderer
local function bindGun()
	if gunC then gunC:Disconnect() gunC = nil end
	local gun, equipped = findMyGun()
	if gun and equipped and gun:IsA("Tool") then
		gunC = gun.Activated:Connect(function()
			if aim.Enabled and aim.Silent then Combat.ShootMurderer() end
		end)
	end
end
local function watchChar()
	if watchC then watchC:Disconnect() watchC = nil end
	local ch = myChar()
	if ch then
		watchC = ch.ChildAdded:Connect(function(c)
			if looksLikeGun(c) then task.wait(0.1) bindGun() end
		end)
	end
	bindGun()
end
function Aim.SetEnabled(state)
	aim.Enabled = state and true or false
	if aim.Enabled then
		if not aimConn then aimConn = RunService.RenderStepped:Connect(aimStep) end
		if not downC then
			downC = UIS.InputBegan:Connect(function(i, g) if not g and i.KeyCode == aim.Key then held = true end end)
			upC = UIS.InputEnded:Connect(function(i) if i.KeyCode == aim.Key then held = false end end)
		end
		watchChar()
		LP.CharacterAdded:Connect(function() task.wait(1) watchChar() end)
	else
		held = false
		if aimConn then aimConn:Disconnect() aimConn = nil end
	end
end
function Aim.SetKey(k) if k then aim.Key = k end end

--==================================================================-- FLING (SHubFling)
Combat.FlingTimeout = 2.5
function Combat.Fling(targetPlayer)
	task.spawn(function()
		local Char = myChar()
		local Hum  = Char and Char:FindFirstChildOfClass("Humanoid")
		local Root = myRoot()
		if not (Char and Hum and Root and targetPlayer) then return end
		local TChar = targetPlayer.Character
		if not TChar then return end
		local THum   = TChar:FindFirstChildOfClass("Humanoid")
		local TRoot  = THum and THum.RootPart
		local THead  = TChar:FindFirstChild("Head")
		local Acc    = TChar:FindFirstChildOfClass("Accessory")
		local Handle = Acc and Acc:FindFirstChild("Handle")
		local oldPos = Root.CFrame
		repeat task.wait()
			Workspace.CurrentCamera.CameraSubject = THead or Handle or THum
		until Workspace.CurrentCamera.CameraSubject == (THead or Handle or THum)
		local function FPos(bp, pos, ang)
			local cf = CFrame.new(bp.Position) * pos * ang
			Root.CFrame = cf
			pcall(function() Char:SetPrimaryPartCFrame(cf) end)
			Root.AssemblyLinearVelocity = Vector3.new(9e7, 9e8, 9e7)
			Root.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)
		end
		local function spin(bp)
			local start = tick()
			local angle = 0
			repeat
				if Root and THum then
					angle = angle + 100
					for _, off in ipairs({ CFrame.new(0, 1.5, 0), CFrame.new(0, -1.5, 0), CFrame.new(2.25, 1.5, -2.25), CFrame.new(-2.25, -1.5, 2.25) }) do
						FPos(bp, off + THum.MoveDirection, CFrame.Angles(math.rad(angle), 0, 0))
						task.wait()
					end
				end
			until bp.AssemblyLinearVelocity.Magnitude > 500 or tick() - start > Combat.FlingTimeout
		end
		local BV = Instance.new("BodyVelocity")
		BV.Velocity = Vector3.new(9e8, 9e8, 9e8)
		BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		BV.Parent = Root
		Hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
		local tp = TRoot or THead or Handle
		if tp then spin(tp) end
		BV:Destroy()
		Hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
		repeat
			local cf = oldPos * CFrame.new(0, 0.5, 0)
			Root.CFrame = cf
			pcall(function() Char:SetPrimaryPartCFrame(cf) end)
			pcall(function() Hum:ChangeState("GettingUp") end)
			for _, p in ipairs(Char:GetChildren()) do
				if p:IsA("BasePart") then p.AssemblyLinearVelocity, p.AssemblyAngularVelocity = Vector3.zero, Vector3.zero end
			end
			task.wait()
		until (Root.Position - oldPos.Position).Magnitude < 25
		pcall(function() Workspace.CurrentCamera.CameraSubject = Hum end)
	end)
end
function Combat.FlingMurderer()
	local m = findMurderer()
	if m then Combat.Fling(m) end
end

-- флингануть всех на серваке (по очереди, чтобы не сломать восстановление позиции)
Combat.FlingingAll = false
function Combat.FlingAll()
	if Combat.FlingingAll then return end
	Combat.FlingingAll = true
	task.spawn(function()
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl ~= LP and pl.Character then
				Combat.Fling(pl)
				-- ждём завершения текущего флинга (позиция восстановлена)
				task.wait(Combat.FlingTimeout + 0.5)
			end
		end
		Combat.FlingingAll = false
	end)
end

--==================================================================-- STEAL GUN
-- Правильный порядок: ФЛИНГУЕМ шерифа (у него пистолет) -> ждём, пока он
-- умрёт/ресетнется и ВЫРОНИТ пистолет -> подбираем выпавший GunDrop ->
-- возвращаемся на исходную точку. Есть авто-режим.
Combat.AutoSteal    = false
Combat.Stealing     = false
Combat.StealTimeout = 8   -- сколько максимум ждём выпадения пистолета

-- предмет считается «в руках», если он лежит внутри чьего-либо персонажа
local function isInsideCharacter(inst)
	local p = inst
	while p and p ~= Workspace do
		if Players:GetPlayerFromCharacter(p) then return true end
		p = p.Parent
	end
	return false
end

-- ищем именно ВЫПАВШИЙ пистолет (свободно лежащий на карте, не в руках)
local function findDroppedGun()
	-- прямой дроп MM2 называется GunDrop
	local drop = Workspace:FindFirstChild("GunDrop", true)
	if drop then
		if drop:IsA("BasePart") then return drop end
		local bp = drop:FindFirstChildWhichIsA("BasePart", true)
		if bp then return bp end
	end
	-- фолбэк: любой свободный Gun / Revolver / GunPickup на карте
	for _, v in ipairs(Workspace:GetDescendants()) do
		if v:IsA("BasePart") and not isInsideCharacter(v) then
			local n = v.Name
			if n == "GunDrop" or n == "GunPickup" or n == "Gun" or n == "Revolver"
				or (v.Parent and v.Parent.Name == "GunDrop") then
				return v
			end
		end
	end
	return nil
end

-- тянем выпавший пистолет к игроку, чтобы сработал автоподбор
local function pullGun(part, root)
	pcall(function()
		part.CFrame = root.CFrame
		part.AssemblyLinearVelocity  = Vector3.zero
		part.AssemblyAngularVelocity = Vector3.zero
	end)
end

function Combat.StealGun()
	if Combat.Stealing then return end
	Combat.Stealing = true
	task.spawn(function()
		local ok = pcall(function()
			local Root = myRoot()
			if not Root then return end
			local m = findSheriff()          -- цель — ШЕРИФ (держатель пистолета)
			if not m then
				pcall(function() Library:Notify({ Title = "Steal Gun", Text = "Шериф не найден", Kind = "warning" }) end)
				return
			end
			local origin = Root.CFrame        -- запоминаем исходную точку

			-- 1) ФЛИНГ шерифа: улетает с карты и погибает
			Combat.Fling(m)

			-- 2) ждём, пока сам флинг отработает (нас возвращает на место)
			task.wait(Combat.FlingTimeout + 1)

			-- 3) ждём ресета шерифа и выпадения пистолета
			local start = tick()
			local gun
			repeat
				task.wait(0.1)
				gun = findDroppedGun()
			until gun or (tick() - start > Combat.StealTimeout)

			if not gun then
				pcall(function() Library:Notify({ Title = "Steal Gun", Text = "Пистолет не выпал (шериф не ресетнулся)", Kind = "warning" }) end)
			else
				-- 4) подбираем: тянем дроп к себе, пока не окажется в руках
				local grabbed = false
				for _ = 1, 20 do
					local r2 = myRoot()
					local g  = (gun and gun.Parent) and gun or findDroppedGun()
					if not (g and r2) then break end
					pullGun(g, r2)
					task.wait(0.08)
					if hasTool(LP, "Gun", "Revolver") then grabbed = true break end
				end
				pcall(function()
					Library:Notify({
						Title = "Steal Gun",
						Text  = grabbed and "Пистолет украден!" or "Пистолет подтянут, проверь инвентарь",
						Kind  = grabbed and "success" or "info",
					})
				end)
			end

			-- 5) телепортируемся обратно на исходную точку
			local r3 = myRoot()
			if r3 then pcall(function() r3.CFrame = origin end) end
		end)
		Combat.Stealing = false
		if not ok then
			pcall(function() Library:Notify({ Title = "Steal Gun", Text = "Ошибка стила", Kind = "error" }) end)
		end
	end)
end

