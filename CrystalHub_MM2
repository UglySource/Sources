local invSaved = {}
local function invApply(on)
	local c = char()
	if not c then return end
	for _, p in ipairs(c:GetDescendants()) do
		if p:IsA("BasePart") or p:IsA("Decal") then
			if on then
				if invSaved[p] == nil then invSaved[p] = p.Transparency end
				pcall(function() p.Transparency = 1 end)
			else
				if invSaved[p] ~= nil then pcall(function() p.Transparency = invSaved[p] end) end
			end
		end
	end
	if not on then invSaved = {} end
end
function World.SetInvisible(on)
	st.Invisible = on and true or false
	invApply(st.Invisible)
end

