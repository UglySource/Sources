	end)

	configSection:AddButton("@set.save", function()
		if Window:SaveConfig(configName) then
			Window:Notify({ Title = "Crystal Hub", Text = "Config saved: " .. configName, Duration = 3 })
		else
			Window:Notify({
				Title = "Crystal Hub", Text = "Could not write the config file",
				Duration = 3, Color = Color3.fromRGB(230, 90, 100),
			})
		end
	end, "config_save")

	configSection:AddButton("@set.load", function()
		if Window:LoadConfig(configName) then
			Window:Notify({ Title = "Crystal Hub", Text = "Config loaded: " .. configName, Duration = 3 })
		else
			Window:Notify({
				Title = "Crystal Hub", Text = "Config not found: " .. configName,
				Duration = 3, Color = Color3.fromRGB(230, 170, 80),
			})
		end
	end, "config_load")

	statusLabel:Set(Library:T("ui.bindHint"))

	Window:Notify({
		Title    = "Crystal Hub",
		Text     = "Right Ctrl — hide · drag the corner to resize",
		Duration = 5,
		Kind     = "success",
	})
end

