-- Обычная ходьба; прыжок во время движения резко ускоряет на короткое время.
local sgBaseSpeed, sgBoostSpeed, sgBoostTime = 16, 90, 0.9
local sgConn
local function stopSpeedGlitch()
	if sgConn then sgConn:Disconnect() sgConn = nil end
	local h = hum()
	if h then pcall(function() h.WalkSpeed = sgBaseSpeed end) end
end
local function startSpeedGlitch()
	stopSpeedGlitch()
	local boostUntil = 0
	sgConn = UIS.JumpRequest:Connect(function()
		if not st.SpeedGlitch then return end
		local h, r = hum(), root()
		if not (h and r) then return end
		-- ускоряем только если реально движемся
		local moving = Vector3.new(r.AssemblyLinearVelocity.X, 0, r.AssemblyLinearVelocity.Z).Magnitude > 3
		if moving then boostUntil = tick() + sgBoostTime end
	end)
	task.spawn(function()
		while st.SpeedGlitch do
			local h = hum()
			if h then
				pcall(function()
					h.WalkSpeed = (tick() < boostUntil) and sgBoostSpeed or sgBaseSpeed
				end)
			end
			task.wait(0.05)
		end
	end)
end
function World.SetSpeedGlitch(on)
