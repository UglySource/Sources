local Spinner = {}

Spinner.Settings = {
	Enabled   = false,
	Speed     = 3,
	Direction = 1,   -- 1 = по часовой, -1 = против
}

local spinSettings  = Spinner.Settings
local spinConn

function Spinner.SetEnabled(enabled)
	spinSettings.Enabled = enabled and true or false
	if spinConn then
		spinConn:Disconnect()
		spinConn = nil
	end
	-- вернуть авто-разворот персонажу при выключении
	if not spinSettings.Enabled then
		pcall(function()
			local char = LocalPlayer.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then hum.AutoRotate = true end
		end)
		return
	end

	spinConn = RunService.Heartbeat:Connect(function(dt)
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then return end
		-- гасим авто-разворот, иначе движение игрока борется с вращением
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and hum.AutoRotate then hum.AutoRotate = false end
		-- крутим ТОЛЬКО тело вокруг вертикальной оси; камера/экран не трогаем
		root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(spinSettings.Speed * spinSettings.Direction * dt * 60), 0)
	end)
end

function Spinner.SetSpeed(value)
	spinSettings.Speed = value
end

function Spinner.SetDirection(dir)
	spinSettings.Direction = dir
end

