	if k == Enum.KeyCode.W then flyKeys.F = 1
	elseif k == Enum.KeyCode.S then flyKeys.B = -1
	elseif k == Enum.KeyCode.A then flyKeys.L = -1
	elseif k == Enum.KeyCode.D then flyKeys.R = 1 end
end)
UIS.InputEnded:Connect(function(i)
