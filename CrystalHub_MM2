-- перерисовываем прицел (нужно для режима "Только при Shift Lock" и чтобы
-- заменить появляющийся при shift-lock стандартный прицел на наш)
local function ensureShiftWatch()
	if shiftLockConn then return end
	shiftLockConn = UserInputService:GetPropertyChangedSignal("MouseBehavior"):Connect(function()
		if cross.Enabled then
			Crosshair.Apply()
		end
	end)
end

function Crosshair.SetEnabled(state)
	cross.Enabled = state and true or false
	if cross.Enabled then ensureShiftWatch() ensureSpin() end
	Crosshair.Apply()
end

function Crosshair.SetStyle(key)
	cross.Style = key
	Crosshair.Apply()
end

function Crosshair.Destroy()
	if shiftLockConn then shiftLockConn:Disconnect() shiftLockConn = nil end
	if spinConn then spinConn:Disconnect() spinConn = nil end
	hideDefaultCursor(false)
	if pickerGui then pickerGui:Destroy() pickerGui = nil end
	if crossGui then crossGui:Destroy() crossGui = nil crossHolder = nil end
end

