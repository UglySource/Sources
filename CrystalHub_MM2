	-- кнопка на экране: круглая или вытянутая
	local floating

	local function spawnFloating(style)
		if floating then
			floating:Destroy()
			floating = nil
		end
		floating = Library:CreateFloatingButton({
			Style    = style,
			Text     = style == "pill" and "SIMPLE UI" or "S",
			Callback = function()
				Window:Toggle()
			end,
		})
	end

	uiSection:AddDropdown("@set.buttonStyle", { "circle", "pill" }, "circle", function(choice)
		spawnFloating(choice)
	end, "ui_button_style")

	uiSection:AddToggle("@set.button", true, function(enabled)
		if enabled then
			spawnFloating(Library.Flags.ui_button_style or "circle")
		elseif floating then
			floating:Destroy()
			floating = nil
		end
	end, "ui_button")

	uiSection:AddButton("@set.hide", function()
		Window:Toggle()
	end, "ui_hide")

	-- тумблер выше стоит в положении «включено», поэтому создаём кнопку сразу:
	-- элементы не вызывают колбэк при инициализации
	spawnFloating("circle")

	local configSection = settingsTab:AddSection("@set.config")
