-- прячем/возвращаем стандартный курсор Роблокса (в т.ч. прицел shift-lock)
local function hideDefaultCursor(hide)
	pcall(function()
		local m = LocalPlayer:GetMouse()
		if hide then
			if savedCursorId == nil then savedCursorId = m.Icon end
			-- пустая иконка = курсора/шифт-лок прицела не видно, остаётся только наш
			m.Icon = "rbxasset://textures/blank.png"
		else
			if savedCursorId ~= nil then m.Icon = savedCursorId savedCursorId = nil end
		end
	end)
end

function Crosshair.Apply()
	-- любой сбой отрисовки гасится здесь и не уходит наружу
	pcall(function()
		ensureGui()
		for _, c in ipairs(crossHolder:GetChildren()) do
			c:Destroy()
		end
		local visible = cross.Enabled and (not cross.ShiftLockOnly or isShiftLock())
		crossGui.Enabled = visible
		-- прячем стандартный курсор, только когда наш прицел реально виден
		hideDefaultCursor(visible and cross.HideDefault)
		if not visible then return end
		crossHolder.Rotation = cross.Rotation or 0
		findStyle(cross.Style).Build(crossHolder, cross)
	end)
end

-- непрерывное вращение прицела (крутится только сам прицел, не экран)
local function ensureSpin()
	if spinConn then return end
	spinConn = RunService.RenderStepped:Connect(function(dt)
		if not (cross.Enabled and cross.Spin and crossGui and crossGui.Enabled and crossHolder) then return end
		cross.Rotation = (cross.Rotation + (cross.SpinSpeed or 90) * dt) % 360
		crossHolder.Rotation = cross.Rotation
	end)
end

