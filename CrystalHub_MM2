				end
			end)
		end, "troll_annoy")

		--==================== SCREEN BUTTONS (gated per-toggle) ====================--
		local floaters = {}
		local function addFloater(key, label, big, cb)
			local b = Library:CreateFloatingButton({
				Style    = "pill",
				Text     = label,
				Width    = big and 150 or 96,
				Height   = big and 52  or 30,
				Callback = cb,
			})
			b:SetVisible(false) -- hidden by default; enabled from the settings
			floaters[key] = b
			return b
		end

		-- SHOOT is the big one; the rest are small
		addFloater("shoot", "SHOOT", true, function() if Combat then Combat.ShootMurderer() end end)
		local aimFloat = addFloater("aimlock", "AIMLOCK: OFF", false, function()
			if not Aim then return end
			if not Aim.Settings.Enabled then Aim.SetEnabled(true) end
			Aim.Settings.HoldKey = false
			Aim.Settings.AimLock = not Aim.Settings.AimLock
			local f = floaters.aimlock
			if f then f:SetText(Aim.Settings.AimLock and "AIMLOCK: ON" or "AIMLOCK: OFF") end
		end)
		local flyFloat = addFloater("fly", "FLY: OFF", false, function()
			if not World then return end
			World.SetFly(not World.State.Fly)
			local f = floaters.fly
			if f then f:SetText(World.State.Fly and "FLY: ON" or "FLY: OFF") end
		end)
		local noclipFloat = addFloater("noclip", "NOCLIP: OFF", false, function()
			if not World then return end
			World.SetNoclip(not World.State.Noclip)
			local f = floaters.noclip
			if f then f:SetText(World.State.Noclip and "NOCLIP: ON" or "NOCLIP: OFF") end
		end)
		addFloater("fling", "FLING", false, function() if Combat then Combat.FlingMurderer() end end)
		addFloater("steal", "STEAL GUN", false, function() if Combat then Combat.StealGun() end end)

		-- lay out the visible buttons in a vertical column on the left
		local function layoutFloaters()
			local order = { "shoot", "aimlock", "fly", "noclip", "fling", "steal" }
			local y = 120
			for _, k in ipairs(order) do
				local b = floaters[k]
				if b and b.Gui and b.Gui.Enabled then
					b.Instance.Position = UDim2.fromOffset(24, y)
					y = y + (k == "shoot" and 64 or 40)
				end
			end
		end

		local btnSec = playerTab:AddSection("Screen Buttons")
		local function mk(key, title, flag)
			btnSec:AddToggle(title, false, function(v)
				local b = floaters[key]
				if b then b:SetVisible(v) end
				layoutFloaters()
			end, flag)
		end
		mk("shoot",   "Show SHOOT button",   "flt_shoot")
		mk("aimlock", "Show AIMLOCK button", "flt_aimlock")
		mk("fly",     "Show FLY button",     "flt_fly")
		mk("noclip",  "Show NOCLIP button",  "flt_noclip")
		mk("fling",   "Show FLING button",   "flt_fling")
		mk("steal",   "Show STEAL GUN button", "flt_steal")

		-- lock/unlock dragging for ALL on-screen buttons at once
		btnSec:AddToggle("Lock buttons (disable drag)", false, function(v)
			Library.FloatersLocked = v and true or false
			-- also flag each known floater directly (belt and suspenders)
			for _, b in pairs(floaters) do
				if b and b.SetLocked then b:SetLocked(v) end
			end
		end, "flt_lock")
	end)

