--------------------------------------------------------------- FLY
local flyBV, flyBG, flyConn, flyKeys = nil, nil, nil, { F = 0, B = 0, L = 0, R = 0 }
local function stopFly()
	if flyConn then flyConn:Disconnect() flyConn = nil end
	if flyBV then flyBV:Destroy() flyBV = nil end
	if flyBG then flyBG:Destroy() flyBG = nil end
	local h = hum()
	if h then h.PlatformStand = false end
	flyKeys = { F = 0, B = 0, L = 0, R = 0 }
end
local function startFly()
	local r, h = root(), hum()
	if not (r and h) then return end
	stopFly()
	flyBG = Instance.new("BodyGyro", r)
	flyBG.P = 9e4
	flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	flyBG.CFrame = r.CFrame
	flyBV = Instance.new("BodyVelocity", r)
	flyBV.Velocity = Vector3.new(0, 0.1, 0)
	flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	flyConn = RunService.Heartbeat:Connect(function()
		local hh = hum()
		local rr = root()
		if not (hh and rr and flyBV and flyBG) then return end
		hh.PlatformStand = true
		local c = Workspace.CurrentCamera
		local fwd = (flyKeys.F + flyKeys.B)
		local side = (flyKeys.L + flyKeys.R)
		if fwd ~= 0 or side ~= 0 then
			flyBV.Velocity = (c.CFrame.LookVector * fwd
				+ (c.CFrame * CFrame.new(side, 0, 0).Position - c.CFrame.Position)) * st.FlySpeed
		else
			flyBV.Velocity = Vector3.new(0, 0.1, 0)
		end
		flyBG.CFrame = c.CFrame
	end)
end
