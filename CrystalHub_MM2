function Library:CreateWindow(config)
	config = config or {}

	local titleText = config.Title      or "SimpleUI"
	local subText   = config.Subtitle   or ""
	local size      = config.Size       or UDim2.fromOffset(620, 430)
	local keybind   = config.Keybind    or Enum.KeyCode.RightControl
	local folder    = config.ConfigDir  or "SimpleUI"

	local width  = size.X.Offset
	local height = size.Y.Offset

	-- === адаптация под телефон ===
	-- тач-устройство без клавиатуры ИЛИ просто маленький экран считаем «мобилкой»
	local vp0      = viewportSize()
	local isMobile = (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled)
		or vp0.X < 700 or vp0.Y < 520
	if isMobile then
		-- окно занимает почти весь экран, но не меньше разумного минимума
		width  = math.clamp(math.floor(vp0.X * 0.92), 300, width)
		height = math.clamp(math.floor(vp0.Y * 0.88), 260, height)
	end

	-- ширина боковой панели и ширина свёрнутой «таблетки»
	local sidebarWidth = isMobile and 120 or 156
	local minWidth     = math.min(isMobile and 220 or 250, width)
	-- нижние границы при ручном ресайзе за угол (не больше текущего размера)
	local minMinW      = math.min(isMobile and 300 or 460, width)
	local minMinH      = math.min(isMobile and 220 or 300, height)

	-- все подписки на UserInputService складываем сюда, чтобы отключить при закрытии
	local connections = {}
	local function track(conn)
		table.insert(connections, conn)
		return conn
	end

	local dragState = { Clamp = config.ClampToScreen ~= false }

	local screenGui = new("ScreenGui", {
		Name           = "SimpleUI",
		ResetOnSpawn   = false,
		IgnoreGuiInset = true,
		DisplayOrder   = 999,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent         = PlayerGui,
	})

	local viewport = viewportSize()
	local main = new("Frame", {
		Name             = "Main",
		Size             = UDim2.fromOffset(width, height),
		Position         = UDim2.fromOffset(
			math.max((viewport.X - width) / 2, 0),
			math.max((viewport.Y - height) / 2, 0)
		),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel  = 0,
		ClipsDescendants = true,
		Active           = true,
		Parent           = screenGui,
	})
	corner(main, WINDOW_RADIUS)
	stroke(main, Theme.Stroke, 1, 0.15)
