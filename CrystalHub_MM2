-- Многие ID из каталога — это Decal, а не Image. ImageLabel.Image ждёт
-- именно текстуру, поэтому «голый» decal-ID не рисуется (работал только Star,
-- т.к. он уже image). Резолвим decal -> текстуру через game:GetObjects и
-- кэшируем. Числовой ID -> сначала пробуем как есть, потом как decal.
local decalCache = {}
local function resolveImageId(assetId)
	local id = tostring(assetId)
	if id:find("rbxassetid") or id:find("rbxthumb") or id:find("http") then return id end
	id = id:gsub("%D", "")            -- оставить только цифры
	if id == "" then return "" end
	if decalCache[id] then return decalCache[id] end
	local direct = "rbxassetid://" .. id
	decalCache[id] = direct           -- дефолт: как image- id
	-- асинхронно пробуем достать текстуру из decal и подменить кэш
	task.spawn(function()
		local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
		if ok and objs and objs[1] then
			local o = objs[1]
			local tex = (o:IsA("Decal") or o:IsA("Texture")) and o.Texture
				or (o:IsA("ImageLabel") and o.Image) or nil
			if tex and tex ~= "" then decalCache[id] = tex end
			o:Destroy()
		end
	end)
	return direct
end

-- картинка-прицел из ассета. tint=true — красить в s.Color
local function cImage(parent, assetId, s, size, tint)
	if not assetId or assetId == "" then return end
	local id = tostring(assetId)
	if not id:find("rbxassetid") and not id:find("rbxthumb") then
		id = resolveImageId(id)
	end
	local img = vnew("ImageLabel", {
		Size                   = UDim2.fromOffset(size, size),
		Position               = UDim2.fromScale(0.5, 0.5),
		AnchorPoint            = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Image                  = id,
		ImageTransparency      = s.Opacity or 0,
		ScaleType              = Enum.ScaleType.Fit,
		Parent                 = parent,
	})
	if tint then img.ImageColor3 = s.Color end
	-- если resolve нашёл текстуру уже после создания — обновим через кадр
	local numId = tostring(assetId):gsub("%D", "")
	task.spawn(function()
		task.wait(0.15)
		if img.Parent and decalCache[numId] and img.Image ~= decalCache[numId] then
			img.Image = decalCache[numId]
		end
	end)
	return img
end

