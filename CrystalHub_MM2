-- регистр с поддержкой кириллицы (string.lower умеет только ASCII)
local function lowerText(text)
	text = tostring(text or "")
	-- utf8.codes бросает ошибку на битых байтах, поэтому сначала проверяем строку
	if not utf8.len(text) then
		return string.lower(text)
	end

	local result = {}
	for _, code in utf8.codes(text) do
		if code >= 65 and code <= 90 then
			code = code + 32
		elseif code >= 0x410 and code <= 0x42F then
			code = code + 32
		elseif code == 0x401 then
			code = 0x451
		end
		table.insert(result, utf8.char(code))
	end
	return table.concat(result)
end

