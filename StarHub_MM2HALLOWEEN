		if (_G.FpsCapValue or 0) == 0 then
			_G.FpsBoostSetCap(0)
		end

		if not _G.LiteMode and isfile and not isfile("mm2_lite_v372.txt") then
			_G.MM2ScriptConfig.Elements.LiteMode:Set(true)
		end

		if writefile then
			writefile("mm2_lite_v372.txt", "1")
		end
	end)
end

do
	local function v3360(descendant)
		if descendant:IsA("GuiBase2d") then
			descendant.AutoLocalize = false
		end
	end

	local hui = gethui()

	task.spawn(function()
		for i, descendant in ipairs(hui:GetDescendants()) do
			v3360(descendant)

			if i % 2000 == 0 then
				task.wait()
			end
		end
	end)

	local connection = hui.DescendantAdded:Connect(v3360)

	table.insert(_G.CoinESPConn, connection)
end

pcall(_G.__ApplyActionButtonIcons)
pcall(_G.SetActionButtonTextColor, _G.ActionButtonTextColor)
print(_G.ScriptVersion .. " fully loaded (ESP defaults ON, safe MoveTo-based farm)")
