local function SendWebhook(collectedAmount)
    local webhookUrl = Options.Webhook and Options.Webhook:GetInput()
    if not webhookUrl or webhookUrl == "" then return end

    local interval = Options.WebhookTimeInSeconds or 60
    local mins = interval / 60
    local estHourly = math.floor((collectedAmount / interval) * 3600)
    local curTime = os.date("!*t", os.time())

    local requestFunc = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not requestFunc then return end

    local payload = HttpService:JSONEncode({
        username = "Coin Tracker",
        avatar_url = "https://cdn.discordapp.com/avatars/1408303089513009162/1fa188f8e9af284340171e003fd30bf4.webp?size=80",
        embeds = {
            {
                title = "**Player Currency Tracker**",
                color = 16777215,
                fields = {
                    { name = "Bag:", value = tostring(LocalPlayer:GetAttribute("Coins") or 0), inline = false },
                    { name = "Coins Collected in " .. string.format("%.1f", mins) .. " Minutes:", value = tostring(collectedAmount), inline = false },
                    { name = "Estimated Coins per Hour:", value = tostring(estHourly), inline = false }
                },
                timestamp = string.format("%d-%02d-%02dT%02d:%02d:%02dZ", curTime.year, curTime.month, curTime.day, curTime.hour, curTime.min, curTime.sec),
                footer = { text = "Powered by Vertex" }
            }
        }
    })

    requestFunc({
        Url = webhookUrl,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = payload
    })
end

