    local targetChar = targetPlayer and targetPlayer.Character
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    local targetHumanoid = targetChar and targetChar:FindFirstChild("Humanoid")

    if targetRoot and targetHumanoid then
        local velocity = targetRoot.AssemblyLinearVelocity or Vector3.zero
        local moveDir = targetHumanoid.MoveDirection or Vector3.zero
        local prediction = targetRoot.Position + (velocity * Vector3.new(0, 0.5, 0) * 0.1866)
        
        EquipTool("Gun")
        if gun:FindFirstChild("Shoot") then
            gun.Shoot:FireServer("Shoot", targetRoot.CFrame)
        end
    end
end

local function HasLineOfSight(targetPlayer)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = char:FindFirstChild("HumanoidRootPart")
    local targetChar = targetPlayer and targetPlayer.Character
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not root or not targetRoot then return false end

    local rayDirection = (targetRoot.Position - root.Position).Unit * 50
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { char }

    local result = Workspace:Raycast(root.Position, rayDirection, rayParams)
    return not result or (result.Instance and result.Instance.Parent == targetChar)
end

local function GetNextCoin(mode, playerPosition)
    local container = GetMapContainer("CoinContainer")
    if not container then return nil end

    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local murdererName = FindPlayerHolding("Knife")
    local murdererChar = murdererName and Players:FindFirstChild(murdererName) and Players[murdererName].Character
    local murdererRoot = murdererChar and murdererChar:FindFirstChild("HumanoidRootPart")
    local murdererPos = murdererRoot and murdererRoot.Position

    local closeCoins = {}
    local safeCoins = {}
    local nearestCoin = nil
    local shortestDist = math.huge

    for _, coin in ipairs(container:GetChildren()) do
        if coin.Name == "Coin_Server" and coin:FindFirstChild("TouchInterest") and not coin:GetAttribute("Collected") then
            local coinVisual = coin:FindFirstChild("CoinVisual")
            if coinVisual and root then
                local distToPlayer = (root.Position - coinVisual.Position).Magnitude
                local distToMurderer = murdererPos and (coinVisual.Position - murdererPos).Magnitude or math.huge

                if distToPlayer < shortestDist then
                    shortestDist = distToPlayer
                    nearestCoin = coin
                end

                if distToMurderer >= 25 then
                    table.insert(safeCoins, coin)
                end
                if distToPlayer <= 50 then
                    table.insert(closeCoins, coin)
                end
            end
        end
    end

    if mode == "closest" then
        return nearestCoin
    elseif mode == "random" then
        if #closeCoins > 0 then
            return closeCoins[math.random(1, #closeCoins)]
        elseif #safeCoins > 0 then
            return safeCoins[math.random(1, #safeCoins)]
        end
    end
    return nearestCoin
end

local function CollectCoin(coin, rootPart)
    if not coin or not coin:FindFirstChild("CoinVisual") then return end
    local coinPos = coin.CoinVisual.Position
    local speed = shared.Premium and (shared.Premium.speed or 23) or 21

    if CheckCoinBagFull() then return end

    local targetCF = CFrame.new(coinPos.X, coinPos.Y + 1.5, coinPos.Z)
    local mode = Options.Mode and Options.Mode:GetValue()

    if mode ~= "Randomize" then
        MoveToCFrame(targetCF, speed, true, true, coin)
    else
        MoveToCFrame(targetCF, speed, false, true, coin)
    end
end

local function UpdatePlayerChams()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if not char then
                if ActiveChams[player] then
                    ActiveChams[player]:Destroy()
                    ActiveChams[player] = nil
                end
            else
                local highlight = char:FindFirstChild("Highlight") or Instance.new("Highlight", char)
                ActiveChams[player] = highlight

                local roleData = roles and roles[player.Name]
                if not roleData then
                    highlight.FillColor = Color3.fromRGB(255, 255, 255)
                else
                    if roleData.Role == "Murderer" then
                        highlight.FillColor = Color3.fromRGB(225, 0, 0)
                    elseif roleData.Role == "Sheriff" or roleData.Role == "Hero" then
                        highlight.FillColor = Color3.fromRGB(0, 0, 225)
                    else
                        highlight.FillColor = Color3.fromRGB(76, 215, 134)
                    end
                end
            end
        end
    end
end

local function RemovePlayerChams()
    for player, highlight in pairs(ActiveChams) do
        if highlight then
            highlight:Destroy()
        end
    end
    table.clear(ActiveChams)
end

