local function EquipTool(toolName)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local tool = LocalPlayer.Backpack:FindFirstChild(toolName)
    if humanoid and tool then
        humanoid:EquipTool(tool)
    end
end

local function GetMapContainer(containerType)
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and not string.find(string.lower(obj.Name), "lobby") then
            local coinContainer = obj:FindFirstChild("CoinContainer")
            local spawns = obj:FindFirstChild("Spawns")
            if containerType == "CoinContainer" and coinContainer then
                return coinContainer
            elseif containerType == "Spawns" and spawns then
                return spawns
            end
        end
    end
    return nil
end

local function GetGunDrop()
    local spawns = GetMapContainer("Spawns")
    if spawns and spawns.Parent then
        return spawns.Parent:FindFirstChild("GunDrop")
    end
    return nil
end

local function IsPlayerAlive(player, roleTable)
    local playerRole = roleTable and roleTable[player.Name]
    local character = player.Character
    if playerRole then
        if not playerRole.Killed and not playerRole.Dead then
            return true
        end
        if character and character:FindFirstChild("HumanoidCloned") then
            return true
        end
        return false
    end
    return false
end

local function FindPlayerHolding(toolName)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if player.Backpack:FindFirstChild(toolName) or (player.Character and player.Character:FindFirstChild(toolName)) then
                return player.Name
            end
        end
    end
    return nil
end

