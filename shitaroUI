-- ============================================================
-- unload(): полная очистка библиотеки
-- ============================================================
function lib.unload()
    -- Отключаем все сохранённые коннекты
    for _, conn in ipairs(lib.conns or {}) do
        pcall(function() conn:Disconnect() end)
    end
    lib.conns = {}

    -- Удаляем окна и ScreenGui
    for _, win in pairs(lib.wins or {}) do
        pcall(function()
            if win.shell then win.shell:Destroy() end
        end)
    end
    lib.wins = {}

    for _, br in pairs(lib.browsers or {}) do
        pcall(function() br:Destroy() end)
    end
    lib.browsers = {}

    if screenGui and screenGui.Parent then
        screenGui:Destroy()
    end
end
