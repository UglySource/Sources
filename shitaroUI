-- Утилиты
-- ============================================================
local function measureText(text, size, font)
    return TextService:GetTextSize(
        text, size or 14, font or Enum.Font.GothamBold, Vector2.new(9e9, 9e9)
    )
end

local function tween(instance, props, time, style, dir)
    local t = TweenService:Create(
        instance,
        TweenInfo.new(time or 0.24, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

