-- Хелпер: создать разделитель + иконку + значение
local function createStatRow(layoutOrder, iconAsset, initText, textName)
    local spacer = Instance.new("Frame")
    spacer.LayoutOrder          = layoutOrder
    spacer.Name                 = textName .. "Spacer"
    spacer.BackgroundTransparency= 1
    spacer.ZIndex               = 4
    spacer.BorderSizePixel      = 0
    spacer.Size                 = UDim2.fromOffset(14, 16)
    spacer.Parent               = playerContent

    local divider = Instance.new("Frame")
    divider.AnchorPoint           = Vector2.new(0.5, 0.5)
    divider.BackgroundTransparency= 0.62
    divider.Name                  = textName .. "Divider"
    divider.Position              = UDim2.fromScale(0.5, 0.5)
    divider.BackgroundColor3      = Color3.fromRGB(150, 152, 175)
    divider.ZIndex                = 4
    divider.BorderSizePixel       = 0
    divider.Size                  = UDim2.fromOffset(1, 16)
    divider.Parent                = spacer

    local dividerGradient = Instance.new("UIGradient")
    dividerGradient.Rotation     = 90
    dividerGradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.85),
        NumberSequenceKeypoint.new(0.5, 0),
        NumberSequenceKeypoint.new(1, 0.85),
    })
    dividerGradient.Parent = divider

    local icon = Instance.new("ImageLabel")
    icon.ImageColor3          = Color3.fromRGB(240, 240, 245)
    icon.ScaleType            = Enum.ScaleType.Fit
    icon.ImageTransparency    = 0.25
    icon.Image                = iconAsset
    icon.Name                 = textName .. "Icon"
    icon.LayoutOrder          = layoutOrder + 1
    icon.ZIndex               = 4
    icon.BackgroundTransparency= 1
    icon.Size                 = UDim2.fromOffset(15, 15)
    icon.Parent               = playerContent

    local label = Instance.new("TextLabel")
    label.LayoutOrder         = layoutOrder + 2
    label.TextColor3          = Color3.fromRGB(240, 240, 245)
    label.TextTransparency    = 0.05
    label.Text                = initText
    label.Font                = Enum.Font.GothamMedium
    label.Name                = textName
    label.BackgroundTransparency = 1
    label.TextSize            = 14
    label.ZIndex              = 4
    label.AutomaticSize       = Enum.AutomaticSize.X
    label.Size                = UDim2.fromOffset(0, 20)
    label.Parent              = playerContent

    return label
end

